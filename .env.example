# LazyAF environment template.
#
#   cp .env.example .env      then edit .env
#
# .env IS GITIGNORED AND MUST NEVER BE COMMITTED. This file (.env.example) is
# public and contains PLACEHOLDERS ONLY - never paste a real key here. If you
# ever find yourself editing .env.example to add a value, you are editing the
# wrong file.
#
# Everything below is OPTIONAL unless marked REQUIRED. The stack boots with an
# empty .env; the keys are what unlock the AI agent features.
#
# Compose reads this file automatically when it sits next to the compose file
# you are running (both docker-compose.yml and docker-compose.release.yml).


# =============================================================================
# AI PROVIDER KEYS - the only values you normally need to set
# =============================================================================
# These are passed into the backend, which forwards them to agent step
# containers at run time. Set at least one if you want an agent to do work.
# Cards, repos, pipelines, shell/docker steps and the git server all work with
# neither key set.
#
# REQUIRED to run Claude agents. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# REQUIRED to run Gemini agents. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=


# =============================================================================
# RELEASE IMAGES - only read by docker-compose.release.yml
# =============================================================================
# Image tag applied to every service at once. See QUICKSTART.md for how to
# pick one. Use a released version tag for something reproducible; `main`
# tracks the tip of the default branch and will change under you.
# "latest" only exists once a stable vX.Y.Z release has been published. Until
# then (and to track the tip) use "main", which the images workflow publishes
# on every push to the default branch. Pin a real version for anything you
# care about reproducing.
LAZYAF_VERSION=main

# Registry + namespace the images are pulled from. Override only if you mirror
# the images into your own registry.
LAZYAF_IMAGE_PREFIX=ghcr.io/brennan-vanderlaan/lazyaf

# Host ports. Change these if something already owns 8000 or 5173.
LAZYAF_BACKEND_PORT=8000
LAZYAF_FRONTEND_PORT=5173


# =============================================================================
# BACKEND - all optional, sensible defaults compiled in
# =============================================================================
# Database URL (SQLAlchemy async). The compose files point this at the
# lazyaf-data volume so your state survives a recreate.
#   default: sqlite+aiosqlite:////app/data/lazyaf.db  (in the container)
# DATABASE_URL=

# Where the internal bare git repos are stored inside the backend container.
# Keep it on the data volume or you will lose every ingested repo on recreate.
#   default: /app/data/git_repos
# GIT_REPOS_DIR=

# Docker endpoint the backend uses to spawn step containers.
#   default: unix:///var/run/docker.sock
# DOCKER_HOST=

# Which agent runner a card gets when it does not ask for one: any |
# claude-code | gemini
#   default: any
# DEFAULT_RUNNER_TYPE=

# Global fallback prompt template for AI agents, used when an agent definition
# does not supply its own.
#   default: unset
# DEFAULT_PROMPT_TEMPLATE=

# Number of uvicorn workers. Leave unset for a single worker; the SSE log
# streams and the in-process job queue assume one.
#   default: unset (1 worker)
# WEB_CONCURRENCY=

# Mounts the /api/test reset+seed endpoints. FOR THE E2E HARNESS ONLY - these
# endpoints wipe the database. Never enable on anything you care about.
#   default: off
# LAZYAF_TEST_MODE=


# =============================================================================
# BACKEND - shared secrets. NOT SECRET BY DEFAULT.
# =============================================================================
# Both of these ship with a well-known public default (it is printed in
# backend/app/config.py). That is fine for a laptop stack bound to localhost.
# If this deployment is reachable by anyone else, SET BOTH to long random
# strings. Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
#
# Signs the short-lived JWT a step container uses to call /api/steps/*.
# LAZYAF_STEP_AUTH_SECRET=

# Shared enrollment secret checked when a runner agent dials /ws/runner. A
# runner agent must present this same value as LAZYAF_RUNNER_TOKEN.
# LAZYAF_RUNNER_AUTH_SECRET=


# =============================================================================
# BACKEND - step execution plumbing. Defaults are correct under compose.
# =============================================================================
# Only touch these if you are running the backend outside the provided compose
# topology; they describe how step containers find the rest of the stack.
#
# Named docker network shared by backend, runners and step containers.
#   default: lazyaf-network
# CONTAINER_NETWORK=

# Clone URL template used by the workspace-population helper container.
# Resolved on the container network, so it uses the backend's SERVICE name,
# not localhost.
#   default: http://backend:8000/git/{repo_id}.git
# CONTAINER_GIT_URL_TEMPLATE=

# Backend base URL as seen FROM a step container. Injected into step env as
# LAZYAF_BACKEND_URL.
#   default: http://backend:8000
# CONTAINER_BACKEND_URL=

# Image used by the short-lived `git clone` helper that populates a workspace.
#   default: python:3.12
# WORKSPACE_CLONE_IMAGE=

# Image a pipeline step runs in when it does not name one.
#   default: python:3.12
# STEP_DEFAULT_IMAGE=

# Working directory inside a step container (the checked-out repo).
#   default: /workspace/repo
# STEP_WORKING_DIR=

# HOME inside a step container. Lives on the shared workspace volume so tools
# installed by one step survive into the next.
#   default: /workspace/home
# STEP_HOME_DIR=

# Hourly rates for self-hosted GPU nodes, as a JSON object keyed by node id,
# used to price gpu-node steps in usage reporting. Malformed JSON is logged
# and ignored, never fatal.
#   example: {"my-a100": {"rate_usd_hour": "1.89", "note": "on-prem"}}
# LAZYAF_GPU_NODE_RATES=


# =============================================================================
# RUNNER AGENT - only read when you start the `runner` profile
# =============================================================================
# Stable identity for this agent. MUST be stable across restarts or you orphan
# a registry row on every restart.
#   default: local-runner-1
# LAZYAF_RUNNER_ID=

# Display name in the runner panel.
#   default: local runner
# LAZYAF_RUNNER_NAME=

# Capability labels this agent advertises, comma separated. Pin a pipeline
# step to it with a matching `requires:` block.
#   default: has=docker
#   example: has=docker,has=gpu,zone=workshop
# LAZYAF_RUNNER_LABELS=

# Additional runner-agent variables exist for advanced/remote setups and are
# read directly by the agent, not by compose:
#   LAZYAF_BACKEND_URL           backend the agent dials
#   LAZYAF_RUNNER_TOKEN          enrollment secret; must equal the backend's
#                                LAZYAF_RUNNER_AUTH_SECRET
#   LAZYAF_RUNNER_TYPE           default: generic
#   LAZYAF_ORCHESTRATOR          default: docker
#   LAZYAF_STEP_NETWORK          network step containers join
#   LAZYAF_STEP_BACKEND_URL      backend URL the STEP container should use
#   LAZYAF_GIT_URL_TEMPLATE      clone URL override for this host
#   LAZYAF_BIND_ALLOWLIST        host paths a step is allowed to bind-mount
#   LAZYAF_EXPECT_IMAGES         images this host must already have, else it
#                                advertises has=[images:stale]
#   LAZYAF_RUNNER_ALLOW_INSECURE accept plaintext ws:// to a non-loopback
#                                backend. The execute_step frame carries the
#                                step JWT and the step's secret environment,
#                                so a genuinely remote agent should use wss://
#                                instead of setting this.
#   LAZYAF_RUNNER_LOG_LEVEL      default: INFO


# =============================================================================
# CLI - read by the `lazyaf` command on YOUR machine, not by the containers
# =============================================================================
# Backend the CLI talks to. Match LAZYAF_BACKEND_PORT if you changed it.
#   default: http://localhost:8000
# LAZYAF_SERVER=

# Overrides used by `lazyaf tests` when it cannot infer them from the working
# directory (test collection root, and the repo root the paths are relative to).
# LAZYAF_COLLECT_ROOT=
# LAZYAF_REPO_ROOT=
