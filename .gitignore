# Environment
# Every .env variant is ignored, including backup copies (.env.bak.*), so a
# `git add -A` can never stage one: the tracked-tree secret scanner only sees
# a file AFTER it is in the index. The one tracked template is un-ignored.
.env
.env.local
.env.*
!.env.example

# Database
*.db
*.sqlite

# Docker
.docker/

# OS
.DS_Store
Thumbs.db

# Build outputs
frontend/dist/
backend/data/

# Git server storage
backend/git_repos/

# Logs
*.log

# Test results
frontend/playwright-report/
frontend/test-results/
.pytest_cache/
htmlcov/
coverage.xml
.coverage

# CI gate transient junit outputs (local tier runs)
junit-t*.xml

# Go CLI build outputs (scripts/build_cli.sh)
cli/bin/
cli/dist/
